{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "postgres": {
      "command": "uvx",
      "args": ["postgres-mcp", "--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "${DATABASE_URL_READONLY:-postgresql://plantbase_readonly:plantbase_readonly@localhost:5432/plantbase?schema=public}"
      }
    }
  }
}
