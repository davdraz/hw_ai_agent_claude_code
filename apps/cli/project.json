{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cli/src",
  "projectType": "application",
  "implicitDependencies": ["core", "db"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/cli/tsconfig.json --noEmit" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/cli/tsconfig.json" },
      "outputs": ["{workspaceRoot}/apps/cli/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --project cli" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint apps/cli" }
    }
  }
}
