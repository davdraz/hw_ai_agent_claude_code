# Prisma migráció / seed (read-write), a plantbase_app szerepkörrel
DATABASE_URL="postgresql://plantbase_app:plantbase_app@localhost:5433/plantbase?schema=public"

# Az agent runSql toolja csak ezen a read-only kapcsolaton fut
DATABASE_URL_READONLY="postgresql://plantbase_readonly:plantbase_readonly@localhost:5433/plantbase?schema=public"

# Anthropic API kulcs (https://console.anthropic.com/)
ANTHROPIC_API_KEY=""

# Opcionális: modellnév felülírása
ANTHROPIC_MODEL="claude-sonnet-5"
